# =============================================================================
# PDF Invoice Generator CG — environment template
# Copy to .env and fill in values. Do not commit real secrets.
# Shopify CLI also manages many SHOPIFY_* values via `shopify app dev`.
# =============================================================================

# Shopify (typically set by Shopify CLI / Partners)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_orders,read_customers,read_products
SHOPIFY_APP_URL=

# Database
DATABASE_URL=file:./dev.sqlite

# Support inbox (Help & Support contact form destination)
SUPPORT_MAIL=sbhattti1212@gmail.com
# SUPPORT_EMAIL=  # alternate name; SUPPORT_MAIL wins if both set

# SMTP — Help & Support contact form (Gmail app password recommended)
SMTP_EMAIL=
SMTP_PASS=
# Optional SMTP overrides (defaults: smtp.gmail.com / 465 / true)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Help page links (in-app Help & Support)
# User guide URL — keep available for the future redesigned guide
HELP_CENTER_URL=https://e-invoicing-cg-user-guide-4zcr.vercel.app
# Optional Zoom / calendar booking link (defaults to SUPPORT_EMAIL mailto if empty)
# HELP_SCHEDULE_URL=https://calendly.com/your-link
